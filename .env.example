# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Every variable below is required unless marked optional.
# See docs/architecture.md §13 (Environment) and §6 (Neon connection strings).
# ---------------------------------------------------------------------------

# Pooled Neon connection (PgBouncer). Used by the app at runtime via @prisma/adapter-pg. Ends in `-pooler`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# Unpooled Neon connection. Used by the Prisma CLI (migrations) via prisma.config.ts. No `-pooler`.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# Optional: empty Neon database Prisma uses as a shadow DB for `migrate dev`.
# Only needed if `migrate dev` complains it cannot create a shadow database.
# SHADOW_DATABASE_URL="postgresql://user:password@ep-yyyy.eu-central-1.aws.neon.tech/shadow?sslmode=require"

# Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=""

# Secret token echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token header; verify it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=""

# Anthropic API key. Used only inside src/server/ai.
ANTHROPIC_API_KEY=""

# Secret used to sign manager session cookies. Generate a long random string.
SESSION_SECRET=""

# Public base URL of the deployed app, e.g. https://app.example.com. Used to register the Telegram webhook.
APP_URL="http://localhost:3000"

# Node environment: development | production. Controls webhook (prod) vs long-polling (dev) for the bot.
NODE_ENV="development"
