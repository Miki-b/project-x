# Background job worker image (docs/architecture.md §8, §13).
# Runs `npm run worker` — the 30s job poll loop (startRunner). No HTTP server.
#
# The web (dashboard + Mini App) runs on Vercel and the bot runs as a Vercel webhook;
# only this persistent poll loop needs an always-on host, which is what Fly.io provides.
FROM node:22-slim

WORKDIR /app

# Install dependencies first for better layer caching. `npm ci` runs the postinstall
# `prisma generate`, which needs the schema and prisma.config.ts (but not DIRECT_URL —
# the config reads it tolerantly). NODE_ENV is intentionally unset here so devDependencies
# install: the worker runs through `tsx`, which is a devDependency.
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

# App source. src/generated is git-/docker-ignored and was (re)generated by postinstall above.
COPY . .

# Runtime is production; set after install so the devDependency install above is unaffected.
ENV NODE_ENV=production

CMD ["npm", "run", "worker"]
